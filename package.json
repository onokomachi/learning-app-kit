{
  "name": "learning-app-kit",
  "version": "0.7.0",
  "description": "\u5358\u5143\u5b66\u7fd2\u30a2\u30d7\u30ea\u306e\u5171\u901a\u57fa\u76e4: \u9593\u9694\u53cd\u5fa9\u30b9\u30b1\u30b8\u30e5\u30fc\u30e9 / \u554f\u984c\u30b8\u30a7\u30cd\u30ec\u30fc\u30bf\u30fc\u306e\u6c4e\u7528\u691c\u8a3c\u30d8\u30eb\u30d1\u30fc / CI\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8",
  "type": "module",
  "license": "MIT",
  "repository": "github:onokomachi/learning-app-kit",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./review": {
      "types": "./dist/review/index.d.ts",
      "import": "./dist/review/index.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "import": "./dist/verify/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/review/scheduler.test.ts src/verify/checks.test.ts src/sync/storage.test.ts src/sync/push.test.ts src/sync/student.test.ts src/sync/events.test.ts src/sync/handoff.test.ts src/sync/pull.test.ts src/react/roundRecorder.test.ts",
    "check": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@types/react": "^19.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
